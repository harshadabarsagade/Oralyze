# Oralyze Environment Configuration
# Set MOCK_MODE=1 to run offline with zero internet and zero API keys.
# Set MOCK_MODE=0 to use live IBM Cloud services.
MOCK_MODE=1

# Common IBM Cloud API Key (IAM)
# Create in IBM Cloud Console: Manage -> Access (IAM) -> API keys -> Create
IBM_API_KEY=your_ibm_api_key_here

# watsonx.ai Granite Credentials
# Lite Plan: 300,000 tokens / month
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here
GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct

# Watson Speech to Text (STT)
# Lite Plan: 500 minutes / month
STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com/instances/your_instance_id

# Watson Text to Speech (TTS)
# Lite Plan: 10,000 characters / month
TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com/instances/your_instance_id

# IBM Cloudant NoSQL DB
# Lite Plan: 1 GB, 20 reads / 10 writes per sec
CLOUDANT_URL=https://your-account.cloudantnosqldb.appdomain.cloud
CLOUDANT_DB=oralyze_scorecards

# Server Config
PORT=5000
MAX_QUESTIONS=5
